# any OpenAI-compatible endpoint works; these are the Groq defaults
LLM_API_KEY=your-groq-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# mock (default) or boto3
CLOUDBUDDY_EXECUTOR=mock
# with boto3, keep this at 1 unless you really want changes applied
CLOUDBUDDY_DRY_RUN=1
AWS_DEFAULT_REGION=us-east-1
